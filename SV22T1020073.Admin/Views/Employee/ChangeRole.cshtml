@{
    ViewData["Title"] = "Phân quyền nhân viên";
}

<div class="card card-warning card-outline mb-4">
    <div class="card-header">
        <h3 class="card-title">Phân quyền cho nhân viên: <strong>Lê Văn A</strong></h3>
    </div>
    <form onsubmit="event.preventDefault()">
        <div class="card-body">
            <div class="alert alert-info">
                <i class="bi bi-info-circle-fill"></i>
                Chọn các quyền cho nhân viên này.
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Danh sách quyền:</label>
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="role1" name="roles" value="Product">
                            <label class="form-check-label" for="role1">
                                Quản lý sản phẩm
                            </label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="role2" name="roles" value="Order">
                            <label class="form-check-label" for="role2">
                                Quản lý đơn hàng
                            </label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="role3" name="roles" value="Customer">
                            <label class="form-check-label" for="role3">
                                Quản lý khách hàng
                            </label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="role4" name="roles" value="Employee">
                            <label class="form-check-label" for="role4">
                                Quản lý nhân viên
                            </label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="role5" name="roles" value="Report">
                            <label class="form-check-label" for="role5">
                                Xem báo cáo
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-warning">
                <i class="bi bi-save"></i> Lưu phân quyền
            </button>
            <a href="~/Employee" class="btn btn-secondary">
                <i class="bi bi-x-circle"></i> Hủy bỏ
            </a>
        </div>
    </form>
</div>

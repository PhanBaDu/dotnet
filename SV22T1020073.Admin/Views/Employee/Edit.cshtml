@{
    ViewData["Title"] = "Hồ sơ nhân viên";
}

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-body text-center pt-4">
                <div class="position-relative d-inline-block mb-3">
                    <img src="https://i.pravatar.cc/150?u=1" class="rounded-circle border" style="width: 100px; height: 100px; object-fit: cover;" alt="">
                </div>
                <h5 class="fw-bold mb-1">Lê Văn A</h5>
                <p class="text-muted small mb-3">Mã NV: 1</p>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Hồ sơ cá nhân</h3>
            </div>
            <div class="card-body">
                <form onsubmit="event.preventDefault()">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="fullName" class="form-label">Họ tên: <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="fullName" name="fullName" value="Lê Văn A" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="birthDate" class="form-label">Ngày sinh:</label>
                                <input type="date" class="form-control" id="birthDate" name="birthDate">
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="email" class="form-label">Email: <span class="text-danger">*</span></label>
                                <input type="email" class="form-control" id="email" name="email" value="levana@liteshop.vn" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="phone" class="form-label">Điện thoại:</label>
                                <input type="tel" class="form-control" id="phone" name="phone" value="090 123 4567">
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="address" class="form-label">Địa chỉ:</label>
                        <input type="text" class="form-control" id="address" name="address">
                    </div>

                    <div class="mb-3">
                        <label for="roleNames" class="form-label">Chức vụ:</label>
                        <select class="form-select" id="roleNames" name="roleNames">
                            <option value="Staff">Nhân viên</option>
                            <option value="Manager" selected>Quản lý</option>
                            <option value="Admin">Quản trị viên</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="isWorking" name="isWorking" checked>
                            <label class="form-check-label" for="isWorking">
                                Đang làm việc
                            </label>
                        </div>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> Lưu thông tin
                        </button>
                        <a href="~/Employee" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Hủy bỏ
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

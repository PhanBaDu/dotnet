@{
    ViewData["Title"] = "Bảng điều khiển";
}

<!-- Stats Cards -->
<div class="row mb-4">
    <div class="col-lg-3 col-6">
        <div class="small-box bg-info">
            <div class="inner">
                <h3>45,231,890</h3>
                <p>Tổng doanh thu</p>
            </div>
            <div class="icon">
                <i class="bi bi-currency-dollar"></i>
            </div>
            <a href="#" class="small-box-footer">Xem chi tiết <i class="bi bi-arrow-right"></i></a>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-success">
            <div class="inner">
                <h3>2,350</h3>
                <p>Đơn hàng mới</p>
            </div>
            <div class="icon">
                <i class="bi bi-cart-check"></i>
            </div>
            <a href="~/Order" class="small-box-footer">Xem chi tiết <i class="bi bi-arrow-right"></i></a>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-warning">
            <div class="inner">
                <h3>12,234</h3>
                <p>Khách hàng</p>
            </div>
            <div class="icon">
                <i class="bi bi-people"></i>
            </div>
            <a href="~/Customer" class="small-box-footer">Xem chi tiết <i class="bi bi-arrow-right"></i></a>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-danger">
            <div class="inner">
                <h3>573</h3>
                <p>Sản phẩm</p>
            </div>
            <div class="icon">
                <i class="bi bi-box-seam"></i>
            </div>
            <a href="~/Product" class="small-box-footer">Xem chi tiết <i class="bi bi-arrow-right"></i></a>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Tổng quan doanh số</h3>
                <div class="card-tools">
                    <div class="btn-group">
                        <button type="button" class="btn btn-sm btn-default">Ngày</button>
                        <button type="button" class="btn btn-sm btn-default active">Tháng</button>
                        <button type="button" class="btn btn-sm btn-default">Năm</button>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div id="salesChart" style="min-height: 300px;"></div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Doanh thu theo loại hàng</h3>
            </div>
            <div class="card-body">
                <div id="categoryChart" style="min-height: 300px;"></div>
            </div>
        </div>
    </div>
</div>

<!-- Bottom Row -->
<div class="row mt-4">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Đơn hàng gần đây</h3>
                <div class="card-tools">
                    <a href="~/Order" class="btn btn-sm btn-default">Xem tất cả</a>
                </div>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Ngày đặt</th>
                            <th>Tổng cộng</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><a href="~/Order/Detail/1">#ORD-3214</a></td>
                            <td>Phan Bá Đủ</td>
                            <td>06/02/2026</td>
                            <td class="text-end">1,250,000 ₫</td>
                            <td><span class="badge bg-success">Hoàn tất</span></td>
                        </tr>
                        <tr>
                            <td><a href="~/Order/Detail/2">#ORD-3213</a></td>
                            <td>Nguyễn Văn A</td>
                            <td>06/02/2026</td>
                            <td class="text-end">450,000 ₫</td>
                            <td><span class="badge bg-warning">Đang xử lý</span></td>
                        </tr>
                        <tr>
                            <td><a href="~/Order/Detail/3">#ORD-3212</a></td>
                            <td>Trần Thị B</td>
                            <td>05/02/2026</td>
                            <td class="text-end">3,120,000 ₫</td>
                            <td><span class="badge bg-info">Đang giao</span></td>
                        </tr>
                        <tr>
                            <td><a href="~/Order/Detail/4">#ORD-3211</a></td>
                            <td>Lê Văn C</td>
                            <td>05/02/2026</td>
                            <td class="text-end">890,000 ₫</td>
                            <td><span class="badge bg-danger">Đã hủy</span></td>
                        </tr>
                        <tr>
                            <td><a href="~/Order/Detail/5">#ORD-3210</a></td>
                            <td>Hoàng Văn D</td>
                            <td>04/02/2026</td>
                            <td class="text-end">2,100,000 ₫</td>
                            <td><span class="badge bg-success">Hoàn tất</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Sản phẩm bán chạy</h3>
                <div class="card-tools">
                    <a href="~/Product" class="btn btn-sm btn-default">Xem tất cả</a>
                </div>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped">
                    <tbody>
                        <tr>
                            <td>
                                <img src="https://picsum.photos/id/1/48/48" class="img-circle" style="width: 40px; height: 40px; object-fit: cover;" alt="">
                            </td>
                            <td>iPhone 15 Pro Max</td>
                            <td class="text-right">124 đã bán</td>
                        </tr>
                        <tr>
                            <td>
                                <img src="https://picsum.photos/id/2/48/48" class="img-circle" style="width: 40px; height: 40px; object-fit: cover;" alt="">
                            </td>
                            <td>MacBook Pro M3</td>
                            <td class="text-right">85 đã bán</td>
                        </tr>
                        <tr>
                            <td>
                                <img src="https://picsum.photos/id/3/48/48" class="img-circle" style="width: 40px; height: 40px; object-fit: cover;" alt="">
                            </td>
                            <td>Sony WH-1000XM5</td>
                            <td class="text-right">62 đã bán</td>
                        </tr>
                        <tr>
                            <td>
                                <img src="https://picsum.photos/id/4/48/48" class="img-circle" style="width: 40px; height: 40px; object-fit: cover;" alt="">
                            </td>
                            <td>iPad Air M2</td>
                            <td class="text-right">48 đã bán</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script>
        var salesOptions = {
            series: [{
                name: 'Doanh thu',
                data: [3100, 4000, 2800, 5100, 4200, 10900, 10000, 7000, 9000, 12000, 8000, 15000]
            }],
            chart: {
                height: 300,
                type: 'area',
                toolbar: { show: false },
                fontFamily: 'Source Sans 3, sans-serif'
            },
            dataLabels: { enabled: false },
            stroke: { curve: 'smooth', width: 2 },
            fill: {
                type: 'gradient',
                gradient: {
                    shadeIntensity: 1,
                    opacityFrom: 0.4,
                    opacityTo: 0.1,
                    stops: [0, 90, 100]
                }
            },
            xaxis: {
                categories: ['Tháng 1', 'Tháng 2', 'Tháng 3', 'Tháng 4', 'Tháng 5', 'Tháng 6', 'Tháng 7', 'Tháng 8', 'Tháng 9', 'Tháng 10', 'Tháng 11', 'Tháng 12']
            },
            yaxis: {
                labels: {
                    formatter: function (val) {
                        return val.toLocaleString() + ' ₫';
                    }
                }
            },
            colors: ['#3c4b7c'],
            grid: {
                borderColor: '#dee2e6',
                strokeDashArray: 4
            }
        };

        var salesChart = new ApexCharts(document.querySelector("#salesChart"), salesOptions);
        salesChart.render();

        var categoryOptions = {
            series: [44, 55, 13, 33],
            chart: {
                height: 300,
                type: 'donut',
                fontFamily: 'Source Sans 3, sans-serif'
            },
            labels: ['Điện tử', 'Máy tính', 'Phụ kiện', 'Gia dụng'],
            colors: ['#3c4b7c', '#6c757d', '#adb5bd', '#dee2e6'],
            legend: {
                position: 'bottom'
            },
            plotOptions: {
                pie: {
                    donut: {
                        size: '65%'
                    }
                }
            },
            dataLabels: { enabled: false }
        };

        var categoryChart = new ApexCharts(document.querySelector("#categoryChart"), categoryOptions);
        categoryChart.render();
    </script>
}
@{
    ViewData["Title"] = "Quản lý người giao hàng";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title">Danh sách người giao hàng</h3>
        <a href="~/Shipper/Create" class="btn btn-primary btn-sm">
            <i class="bi bi-person-plus me-1"></i> Thêm người giao hàng
        </a>
    </div>
    <div class="card-body">
        <form action="" method="get" class="mb-4">
            <div class="input-group">
                <input type="text" name="searchValue" class="form-control" placeholder="Tìm theo tên người giao hàng...">
                <button type="submit" class="btn btn-primary px-4">Tìm kiếm</button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th style="width: 60px;">Mã</th>
                        <th>Tên người giao hàng</th>
                        <th>Số điện thoại</th>
                        <th class="text-end">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 1; i <= 6; i++)
                    {
                        <tr>
                            <td class="fw-bold">#@(i)</td>
                            <td>
                                <div class="fw-bold">Người giao hàng @i</div>
                            </td>
                            <td>
                                <div class="text-muted">091 122 33@(i)</div>
                            </td>
                            <td class="text-end">
                                <a href="~/Shipper/Edit/@i" class="btn btn-sm btn-default"><i class="bi bi-pencil"></i></a>
                                <a href="~/Shipper/Delete/@i" class="btn btn-sm btn-default text-danger"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4">
            <div class="text-muted small">Hiển thị 6 người giao hàng</div>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item active"><a class="page-link" href="#">1</a></li>
                </ul>
            </nav>
        </div>
    </div>
</div>
